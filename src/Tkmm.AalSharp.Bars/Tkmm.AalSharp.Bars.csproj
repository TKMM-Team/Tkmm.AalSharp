<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tkmm.AalSharp.Amta\Tkmm.AalSharp.Amta.csproj" />
    <ProjectReference Include="..\Tkmm.AalSharp\Tkmm.AalSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <PackageId>Tkmm.AalSharp.Bars</PackageId>
    <Authors>ArchLeaders</Authors>
    <Description>IO library for the v101 BARS (Binary Audio Resources) and v4 AMTA (Audio Metadata) AAL file formats</Description>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <PackageLicenseFile>License.md</PackageLicenseFile>
    <PackageIcon>Icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/EPD-Libraries/Tkmm.AalSharp</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Visible="false" Pack="true" PackagePath="\"
          Include="..\..\License.md"/>
    <None Visible="false" Pack="true" PackagePath="\"
          Include="..\..\Readme.md"/>
    <None Visible="false" Pack="true" PackagePath="\"
          Include="..\..\resources\Icon.png"/>
  </ItemGroup>

</Project>
