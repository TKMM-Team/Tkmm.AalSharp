<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Entish" Version="1.1.2"/>
  </ItemGroup>

  <PropertyGroup>
    <PackageId>Tkmm.AalSharp</PackageId>
    <Authors>ArchLeaders</Authors>
    <Description>Base IO library for AAL file formats</Description>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <PackageLicenseFile>License.md</PackageLicenseFile>
    <PackageIcon>Icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/EPD-Libraries/Tkmm.AalSharp</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Visible="false" Pack="true" PackagePath="\"
          Include="..\..\License.md"/>
    <None Visible="false" Pack="true" PackagePath="\"
          Include="..\..\Readme.md"/>
    <None Visible="false" Pack="true" PackagePath="\"
          Include="..\..\resources\Icon.png"/>
  </ItemGroup>

</Project>
